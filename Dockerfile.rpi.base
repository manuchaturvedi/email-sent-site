# Base image with system dependencies only (no Python pip installs)
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive \
    CHROME_PROFILE_DIR=/app/chrome-profile

# Install system dependencies including Chromium (ARM compatible)
RUN apt-get update && apt-get install -y \
    wget \
    gnupg \
    curl \
    unzip \
    xvfb \
    chromium \
    chromium-driver \
    libxi6 \
    libnss3 \
    gcc \
    python3-dev \
    libxss1 \
    libasound2 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libcups2 \
    libdbus-glib-1-2 \
    libgdk-pixbuf-xlib-2.0-0 \
    libgtk-3-0 \
    libx11-xcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    && rm -rf /var/lib/apt/lists/*

# Create Chrome profile dir
RUN mkdir -p ${CHROME_PROFILE_DIR} && chmod -R 777 ${CHROME_PROFILE_DIR}

WORKDIR /app

ENV CHROME_PATH=/usr/bin/chromium

# Keep container idle by default; this image is a base for final build on Pi
CMD ["tail", "-f", "/dev/null"]
