{% extends "layout.html" %}

{% block title %}LinkedIn Email Automation{% endblock %}

{% block additional_styles %}

<style>
  .card {
    background: rgba(255, 255, 255, 0.1);

    backdrop-filter: blur(12px);    backdrop-filter: blur(12px);

    border-radius: 20px;    border-radius: 20px;

    border: none;    border: none;

    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);

    color: #fff;    color: #fff;

  }  }



  .input-group-text {  .input-group-text {

    background: rgba(255, 255, 255, 0.15);    background: rgba(255, 255, 255, 0.15);

    border: none;    border: none;

    color: #fff;    color: #fff;

    border-radius: 10px 0 0 10px;    border-radius: 10px 0 0 10px;

  }  }



  .form-control {  .form-control {

    background: rgba(255, 255, 255, 0.15);    background: rgba(255, 255, 255, 0.15);

    border: none;    border: none;

    color: #fff;    color: #fff;

    border-radius: 0 10px 10px 0;    border-radius: 0 10px 10px 0;

    padding: 12px 14px;    padding: 12px 14px;

    font-size: 15px;    font-size: 15px;

  }  }



  .form-control:focus {  .form-control:focus {

    background: rgba(255, 255, 255, 0.2);    background: rgba(255, 255, 255, 0.2);

    box-shadow: 0 0 0 2px rgba(0, 198, 255, 0.6);    box-shadow: 0 0 0 2px rgba(0, 198, 255, 0.6);

  }  }



  .btn-primary {  .btn-primary {

    background: linear-gradient(90deg, #0072ff, #00c6ff);    background: linear-gradient(90deg, #0072ff, #00c6ff);

    border: none;    border: none;

    border-radius: 12px;    border-radius: 12px;

    padding: 12px;    padding: 12px;

    font-weight: 600;    font-weight: 600;

    transition: 0.3s;    transition: 0.3s;

  }  }



  .btn-primary:hover {  .btn-primary:hover {

    transform: scale(1.03);    transform: scale(1.03);

    box-shadow: 0 0 15px rgba(0, 198, 255, 0.5);    box-shadow: 0 0 15px rgba(0, 198, 255, 0.5);

  }  }



  .progress-container {  .progress-container {

    background: rgba(255, 255, 255, 0.15);    background: rgba(255, 255, 255, 0.15);

    border-radius: 10px;    border-radius: 10px;

    height: 18px;    height: 18px;

    overflow: hidden;    overflow: hidden;

    margin-top: 10px;    margin-top: 10px;

  }  }



  .progress-bar {  .progress-bar {

    background: linear-gradient(90deg, #00c6ff, #0072ff);    background: linear-gradient(90deg, #00c6ff, #0072ff);

    height: 100%;    height: 100%;

    width: 0%;    width: 0%;

    border-radius: 10px;    border-radius: 10px;

    transition: width 0.3s ease-in-out;    transition: width 0.3s ease-in-out;

  }  }



  .progress-box {  .progress-box {

    background: #0d1117;    background: #0d1117;

    border-radius: 12px;    border-radius: 12px;

    padding: 15px;    padding: 15px;

    height: 250px;    height: 250px;

    overflow-y: auto;    overflow-y: auto;

    font-family: "Fira Code", monospace;    font-family: "Fira Code", monospace;

    font-size: 14px;    font-size: 14px;

    color: #b9dfff;    color: #b9dfff;

    box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.3);    box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.3);

    white-space: pre-wrap;    white-space: pre-wrap;

  }  }



  footer {  footer {

    text-align: center;    text-align: center;

    color: #f1f5f9;    color: #f1f5f9;

    opacity: 0.8;    opacity: 0.8;

    font-size: 0.9rem;    font-size: 0.9rem;

    margin-top: 20px;    margin-top: 20px;

  }  }

</style></style>

{% endblock %}{% endblock %}



{% block content %}{% block content %}

  <div class="container py-5">  <div class="container py-5">

    <div class="col-lg-6 col-md-8 col-sm-10 mx-auto">    <div class="col-lg-6 col-md-8 col-sm-10 mx-auto">

      <div class="card p-4 p-md-5">      <div class="card p-4 p-md-5">

        <div class="d-flex align-items-center mb-3">        <div class="d-flex align-items-center mb-3">

          <i class="bi bi-rocket-takeoff-fill fs-2 text-info me-2"></i>          <i class="bi bi-rocket-takeoff-fill fs-2 text-info me-2"></i>

          <h4 class="mb-0">LinkedIn Email Automation</h4>          <h4 class="mb-0">LinkedIn Email Automation</h4>

        </div>        </div>

        <p class="text-light-50 mb-4">        <p class="text-light-50 mb-4">

          Run LinkedIn job automation using Chrome profile <b>D:\Profile</b>.            Run LinkedIn job automation using Chrome profile <b>D:\Profile</b>.  

          Operates in headless mode — no Chrome window opens.          Operates in headless mode — no Chrome window opens.

        </p>        </p>



        <form id="automationForm" method="POST" action="/run" enctype="multipart/form-data">        <form id="automationForm" method="POST" action="/run" enctype="multipart/form-data">

          <div class="mb-3">          <div class="mb-3">

            <div class="alert alert-info">            <div class="alert alert-info">

              <i class="bi bi-info-circle me-2"></i>              <i class="bi bi-info-circle me-2"></i>

              Emails will be sent from manudrive06@gmail.com with your email in CC              Emails will be sent from manudrive06@gmail.com with your email in CC

            </div>            </div>

          </div>          </div>



          <div class="mb-3">          <div class="mb-3">

            <label>Email Subject</label>            <label>Email Subject</label>

            <div class="input-group">            <div class="input-group">

              <span class="input-group-text"><i class="bi bi-card-text"></i></span>              <span class="input-group-text"><i class="bi bi-card-text"></i></span>

              <input type="text" name="subject" class="form-control" placeholder="Application for DevOps Engineer..." required />              <input type="text" name="subject" class="form-control" placeholder="Application for DevOps Engineer..." required />

            </div>            </div>

          </div>          </div>



          <div class="mb-3">          <div class="mb-3">

            <label>Email Body</label>            <label>Email Body</label>

            <div class="input-group">            <div class="input-group">

              <span class="input-group-text"><i class="bi bi-chat-dots"></i></span>              <span class="input-group-text"><i class="bi bi-chat-dots"></i></span>

              <textarea name="content" class="form-control" rows="5" placeholder="Write your message here..." required></textarea>              <textarea name="content" class="form-control" rows="5" placeholder="Write your message here..." required></textarea>

            </div>            </div>

          </div>          </div>



          <div class="mb-3">          <div class="mb-3">

            <label>Attach Resume</label>            <label>Attach Resume</label>

            <div class="input-group">            <div class="input-group">

              <span class="input-group-text"><i class="bi bi-paperclip"></i></span>              <span class="input-group-text"><i class="bi bi-paperclip"></i></span>

              <input type="file" name="resume" class="form-control" required />              <input type="file" name="resume" class="form-control" required />

            </div>            </div>

          </div>          </div>



          <div class="d-grid mt-4">          <div class="d-grid mt-4">

            <button type="submit" id="runBtn" class="btn btn-primary">            <button type="submit" id="runBtn" class="btn btn-primary">

              <i class="bi bi-play-circle me-2"></i>Run Automation              <i class="bi bi-play-circle me-2"></i>Run Automation

            </button>            </button>

          </div>          </div>

        </form>        </form>



        <!-- Stats Cards -->        <!-- Stats Cards -->

        <div class="row mt-4">        <div class="row mt-4">

          <div class="col-md-4">          <div class="col-md-4">

            <div class="card bg-info bg-opacity-10 border-0">            <div class="card bg-info bg-opacity-10 border-0">

              <div class="card-body text-center">              <div class="card-body text-center">

                <i class="bi bi-envelope-fill fs-3 text-info mb-2"></i>                <i class="bi bi-envelope-fill fs-3 text-info mb-2"></i>

                <h3 id="emailsFound" class="mb-0">0</h3>                <h3 id="emailsFound" class="mb-0">0</h3>

                <div class="text-muted">Emails Found</div>                <div class="text-muted">Emails Found</div>

              </div>              </div>

            </div>            </div>

          </div>          </div>

          <div class="col-md-4">          <div class="col-md-4">

            <div class="card bg-success bg-opacity-10 border-0">            <div class="card bg-success bg-opacity-10 border-0">

              <div class="card-body text-center">              <div class="card-body text-center">

                <i class="bi bi-send-fill fs-3 text-success mb-2"></i>                <i class="bi bi-send-fill fs-3 text-success mb-2"></i>

                <h3 id="emailsSent" class="mb-0">0</h3>                <h3 id="emailsSent" class="mb-0">0</h3>

                <div class="text-muted">Emails Sent</div>                <div class="text-muted">Emails Sent</div>

              </div>              </div>

            </div>            </div>

          </div>          </div>

          <div class="col-md-4">          <div class="col-md-4">

            <div class="card bg-warning bg-opacity-10 border-0">            <div class="card bg-warning bg-opacity-10 border-0">

              <div class="card-body text-center">              <div class="card-body text-center">

                <i class="bi bi-exclamation-triangle-fill fs-3 text-warning mb-2"></i>                <i class="bi bi-exclamation-triangle-fill fs-3 text-warning mb-2"></i>

                <h3 id="emailsFailed" class="mb-0">0</h3>                <h3 id="emailsFailed" class="mb-0">0</h3>

                <div class="text-muted">Failed Sends</div>                <div class="text-muted">Failed Sends</div>

              </div>              </div>

            </div>            </div>

          </div>          </div>

        </div>        </div>



        <!-- Progress Bar -->        <!-- Progress Bar -->

        <div class="progress-container mt-4">        <div class="progress-container mt-4">

          <div id="progressBar" class="progress-bar"></div>          <div id="progressBar" class="progress-bar"></div>

        </div>        </div>



        <div class="mt-3">        <div class="mt-3">

          <h6 class="text-info"><i class="bi bi-terminal me-2"></i>Live Progress</h6>          <h6 class="text-info"><i class="bi bi-terminal me-2"></i>Live Progress</h6>

          <div id="progressBox" class="progress-box"></div>          <div id="progressBox" class="progress-box"></div>

        </div>        </div>



        <!-- Add email list collapse -->        <!-- Add email list collapse -->

        <div class="mt-3">        <div class="mt-3">

          <button class="btn btn-link p-0 text-decoration-none text-info" type="button" data-bs-toggle="collapse" data-bs-target="#emailList">          <button class="btn btn-link p-0 text-decoration-none text-info" type="button" data-bs-toggle="collapse" data-bs-target="#emailList">

            <i class="bi bi-list-ul me-2"></i>View Email List            <i class="bi bi-list-ul me-2"></i>View Email List

          </button>          </button>

          <div class="collapse mt-2" id="emailList">          <div class="collapse mt-2" id="emailList">

            <div class="card bg-dark">            <div class="card bg-dark">

              <div class="card-body">              <div class="card-body">

                <div id="emailListContent" class="small" style="font-family: monospace;"></div>                <div id="emailListContent" class="small" style="font-family: monospace;"></div>

              </div>              </div>

            </div>            </div>

          </div>          </div>

        </div>        </div>

      </div>      </div>



      <footer>Developed by <b>Manu Chaturvedi</b> • Flask + Selenium LinkedIn Bot</footer>      <footer>Developed by <b>Manu Chaturvedi</b> • Flask + Selenium LinkedIn Bot</footer>

    </div>    </div>

  </div>  </div>

{% endblock %}{% endblock %}



{% block scripts %}{% block scripts %}

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById("automationForm");
    const progressBox = document.getElementById("progressBox");
    const runBtn = document.getElementById("runBtn");
    const progressBar = document.getElementById("progressBar");

    // Stats tracking
    const stats = {
      emailsFound: 0,
      emailsSent: 0,
      emailsFailed: 0,
      emailList: new Set()
    };

    function updateStats() {
      document.getElementById('emailsFound').textContent = stats.emailsFound;
      document.getElementById('emailsSent').textContent = stats.emailsSent;
      document.getElementById('emailsFailed').textContent = stats.emailsFailed;

      // Update email list

      const emailListContent = document.getElementById('emailListContent');                <div class="container py-5">

      emailListContent.innerHTML = Array.from(stats.emailList)                  <div class="col-lg-6 col-md-8 col-sm-10 mx-auto">

        .map(email => `<div class="mb-1">📧 ${email}</div>`)                    <div class="card p-4 p-md-5">

        .join('');                      <div class="d-flex align-items-center mb-3">

                              <i class="bi bi-rocket-takeoff-fill fs-2 text-info me-2"></i>

      // Update progress bar                        <h4 class="mb-0">LinkedIn Email Automation</h4>

      if (stats.emailsFound > 0) {                      </div>

        const progress = ((stats.emailsSent + stats.emailsFailed) / stats.emailsFound) * 100;                      <p class="text-light-50 mb-4">Run LinkedIn job automation using Chrome profile <b>D:\\Profile</b>. Operates in headless mode — no Chrome window opens.</p>

        progressBar.style.width = `${progress}%`;

        if (stats.emailsFailed > 0) {                      <form id="automationForm">

          progressBar.style.backgroundColor = '#ffc107';                        <div class="mb-3">

        }                          <div class="alert alert-info">

      }                            <i class="bi bi-info-circle me-2"></i>

    }                            Emails will be sent from manudrive06@gmail.com with your email in CC

                          </div>

    function addLogLine(msg) {                        </div>

      const time = new Date().toLocaleTimeString();

      progressBox.innerHTML += `[${time}] ${msg}\n`;                        <div class="mb-3">

      progressBox.scrollTop = progressBox.scrollHeight;                          <label>Email Subject</label>

                          <div class="input-group">

      // Parse message for stats                            <span class="input-group-text"><i class="bi bi-card-text"></i></span>

      if (msg.includes('📧 Found')) {                            <input type="text" name="subject" class="form-control" placeholder="Application for DevOps Engineer..." required />

        const match = msg.match(/Found (\d+) email/);                          </div>

        if (match) {                        </div>

          stats.emailsFound = parseInt(match[1]);

        }                        <div class="mb-3">

      }                          <label>Email Body</label>

      else if (msg.includes('✅ Sent to')) {                          <div class="input-group">

        stats.emailsSent++;                            <span class="input-group-text"><i class="bi bi-chat-dots"></i></span>

        const email = msg.split('✅ Sent to ')[1];                            <textarea name="content" class="form-control" rows="5" placeholder="Write your message here..." required></textarea>

        if (email) stats.emailList.add(email);                          </div>

      }                        </div>

      else if (msg.includes('❌ Failed to send email to')) {

        stats.emailsFailed++;                        <div class="mb-3">

        const email = msg.split('❌ Failed to send email to ')[1].split(':')[0];                          <label>Attach Resume</label>

        if (email) stats.emailList.add(email);                          <div class="input-group">

      }                            <span class="input-group-text"><i class="bi bi-paperclip"></i></span>

                            <input type="file" name="resume" class="form-control" required />

      updateStats();                          </div>

                        </div>

      // Check for completion message

      if (msg.includes("✅ Automation completed successfully")) {                        <div class="d-grid mt-4">

        runBtn.disabled = false;                          <button type="submit" id="runBtn" class="btn btn-primary">

        runBtn.innerHTML = '<i class="bi bi-play-circle me-2"></i>Run Automation';                            <i class="bi bi-play-circle me-2"></i>Run Automation

                                  </button>

        progressBar.style.width = "100%";                        </div>

        if (stats.emailsFailed === 0) {                      </form>

          progressBar.style.backgroundColor = "#28a745";

        }                      <!-- Stats Cards -->

                      <div class="row mt-4">

        // Show completion toast                        <div class="col-md-4">

        const toast = new bootstrap.Toast(document.createElement('div'));                          <div class="card bg-info bg-opacity-10 border-0">

        toast.innerHTML = `                            <div class="card-body text-center">

          <div class="toast-header ${stats.emailsFailed === 0 ? 'bg-success' : 'bg-warning'} text-white">                              <i class="bi bi-envelope-fill fs-3 text-info mb-2"></i>

            <i class="bi bi-check-circle me-2"></i>                              <h3 id="emailsFound" class="mb-0">0</h3>

            <strong class="me-auto">Automation Complete</strong>                              <div class="text-muted">Emails Found</div>

            <button type="button" class="btn-close" data-bs-dismiss="toast"></button>                            </div>

          </div>                          </div>

          <div class="toast-body">                        </div>

            ✅ Found: ${stats.emailsFound} emails<br>                        <div class="col-md-4">

            📨 Sent: ${stats.emailsSent} emails<br>                          <div class="card bg-success bg-opacity-10 border-0">

            ${stats.emailsFailed > 0 ? `❌ Failed: ${stats.emailsFailed} emails` : ''}                            <div class="card-body text-center">

          </div>                              <i class="bi bi-send-fill fs-3 text-success mb-2"></i>

        `;                              <h3 id="emailsSent" class="mb-0">0</h3>

        document.body.appendChild(toast._element);                              <div class="text-muted">Emails Sent</div>

        toast.show();                            </div>

                          </div>

        // Clean up toast after it's hidden                        </div>

        toast._element.addEventListener('hidden.bs.toast', () => {                        <div class="col-md-4">

          toast._element.remove();                          <div class="card bg-warning bg-opacity-10 border-0">

        });                            <div class="card-body text-center">

      }                              <i class="bi bi-exclamation-triangle-fill fs-3 text-warning mb-2"></i>

    }                              <h3 id="emailsFailed" class="mb-0">0</h3>

                              <div class="text-muted">Failed Sends</div>

    function listenProgress() {                            </div>

      const evtSource = new EventSource("/progress");                          </div>

      evtSource.onmessage = function(event) {                        </div>

        if (!event.data) return; // Skip empty messages (heartbeats)                      </div>

        

        const data = event.data;                      <!-- 🔵 Progress Bar -->

                              <div class="progress-container mt-4">

        // Handle new job notifications                        <div id="progressBar" class="progress-bar"></div>

        if (data.startsWith("NEW_JOB:")) {                      </div>

          addLogLine(data);

          if (!document.getElementById('viewJobsBtn')) {                      <div class="mt-3">

            const container = document.createElement('div');                        <h6 class="text-info"><i class="bi bi-terminal me-2"></i>Live Progress</h6>

            container.id = 'viewJobsBtn';                        <div id="progressBox" class="progress-box"></div>

            container.className = 'mt-3';                      </div>

            container.innerHTML = `<a href="/jobs" target="_blank" class="btn btn-sm btn-outline-info">View Job Posts</a>`;

            document.querySelector('.card').appendChild(container);                      <!-- Add email list collapse -->

          }                      <div class="mt-3">

          return;                        <button class="btn btn-link p-0 text-decoration-none text-info" type="button" data-bs-toggle="collapse" data-bs-target="#emailList">

        }                          <i class="bi bi-list-ul me-2"></i>View Email List

                        </button>

        // Handle progress updates                        <div class="collapse mt-2" id="emailList">

        if (data.startsWith("PROGRESS:")) {                          <div class="card bg-dark">

          const percent = data.replace("PROGRESS:", "");                            <div class="card-body">

          progressBar.style.width = percent + "%";                              <div id="emailListContent" class="small" style="font-family: monospace;"></div>

          return;                            {% extends "layout.html" %}

        }

                            {% block title %}LinkedIn Email Automation{% endblock %}

        addLogLine(data);

                            {% block additional_styles %}

        if (data.includes("🏁")) {                            /* Page-specific styles for the automation UI */

          evtSource.close();                            body { color: #fff; }

          runBtn.disabled = false;                            .card {

          runBtn.innerHTML = '<i class="bi bi-play-circle me-2"></i>Run Again';                              background: rgba(255, 255, 255, 0.1);

        }                              backdrop-filter: blur(12px);

      };                              border-radius: 20px;

                              border: none;

      evtSource.onerror = function() {                              box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);

        addLogLine("❌ Lost connection to server");                            }

        evtSource.close();                            .input-group-text { background: rgba(255,255,255,0.15); border: none; color: #fff; border-radius: 10px 0 0 10px; }

      };                            .form-control { background: rgba(255,255,255,0.15); border: none; color: #fff; border-radius: 0 10px 10px 0; padding: 12px 14px; font-size: 15px; }

    }                            .form-control:focus { background: rgba(255,255,255,0.2); box-shadow: 0 0 0 2px rgba(0,198,255,0.6); }

                            .btn-primary { background: linear-gradient(90deg,#0072ff,#00c6ff); border: none; border-radius: 12px; padding: 12px; font-weight:600; }

    form.addEventListener("submit", async (e) => {                            .btn-primary:hover { transform: scale(1.03); box-shadow: 0 0 15px rgba(0,198,255,0.5); }

      e.preventDefault();                            .progress-container { background: rgba(255,255,255,0.15); border-radius:10px; height:18px; overflow:hidden; margin-top:10px; }

                                  .progress-bar { background: linear-gradient(90deg,#00c6ff,#0072ff); height:100%; width:0%; border-radius:10px; transition: width 0.3s ease-in-out; }

      progressBox.innerHTML = "🚀 Starting automation...\n";                            .progress-box { background:#0d1117; border-radius:12px; padding:15px; height:250px; overflow-y:auto; font-family:"Fira Code", monospace; font-size:14px; color:#b9dfff; box-shadow: inset 0 0 10px rgba(0,0,0,0.3); white-space: pre-wrap; }

      progressBar.style.width = "0%";                            footer { text-align:center; color:#f1f5f9; opacity:0.8; font-size:0.9rem; margin-top:20px; }

      progressBar.style.backgroundColor = "#0072ff";                            {% endblock %}

      runBtn.disabled = true;

      runBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Running...';                            {% block content %}

                              <div class="container py-5">

      // Reset stats                                <div class="col-lg-6 col-md-8 col-sm-10 mx-auto">

      stats.emailsFound = 0;                                  <div class="card p-4 p-md-5">

      stats.emailsSent = 0;                                    <div class="d-flex align-items-center mb-3">

      stats.emailsFailed = 0;                                      <i class="bi bi-rocket-takeoff-fill fs-2 text-info me-2"></i>

      stats.emailList.clear();                                      <h4 class="mb-0">LinkedIn Email Automation</h4>

      updateStats();                                    </div>

                                    <p class="text-light-50 mb-4">Run LinkedIn job automation using Chrome profile <b>D:\\Profile</b>. Operates in headless mode — no Chrome window opens.</p>

      try {

        // Submit the form                                    <form id="automationForm">

        const response = await fetch(form.action, {                                      <div class="mb-3">

          method: form.method,                                        <div class="alert alert-info">

          body: new FormData(form)                                          <i class="bi bi-info-circle me-2"></i>

        });                                          Emails will be sent from manudrive06@gmail.com with your email in CC

                                        </div>

        if (!response.ok) {                                      </div>

          throw new Error(`Server returned ${response.status}: ${response.statusText}`);

        }                                      <div class="mb-3">

                                        <label>Email Subject</label>

        listenProgress();                                        <div class="input-group">

      } catch (error) {                                          <span class="input-group-text"><i class="bi bi-card-text"></i></span>

        addLogLine(`❌ Error: ${error.message}`);                                          <input type="text" name="subject" class="form-control" placeholder="Application for DevOps Engineer..." required />

        runBtn.disabled = false;                                        </div>

        runBtn.innerHTML = '<i class="bi bi-play-circle me-2"></i>Run Automation';                                      </div>

      }

    });                                      <div class="mb-3">

  });                                        <label>Email Body</label>

</script>                                        <div class="input-group">

{% endblock %}                                          <span class="input-group-text"><i class="bi bi-chat-dots"></i></span>
                                          <textarea name="content" class="form-control" rows="5" placeholder="Write your message here..." required></textarea>
                                        </div>
                                      </div>

                                      <div class="mb-3">
                                        <label>Attach Resume</label>
                                        <div class="input-group">
                                          <span class="input-group-text"><i class="bi bi-paperclip"></i></span>
                                          <input type="file" name="resume" class="form-control" required />
                                        </div>
                                      </div>

                                      <div class="d-grid mt-4">
                                        <button type="submit" id="runBtn" class="btn btn-primary">
                                          <i class="bi bi-play-circle me-2"></i>Run Automation
                                        </button>
                                      </div>
                                    </form>

                                    <!-- Stats Cards -->
                                    <div class="row mt-4">
                                      <div class="col-md-4">
                                        <div class="card bg-info bg-opacity-10 border-0">
                                          <div class="card-body text-center">
                                            <i class="bi bi-envelope-fill fs-3 text-info mb-2"></i>
                                            <h3 id="emailsFound" class="mb-0">0</h3>
                                            <div class="text-muted">Emails Found</div>
                                          </div>
                                        </div>
                                      </div>
                                      <div class="col-md-4">
                                        <div class="card bg-success bg-opacity-10 border-0">
                                          <div class="card-body text-center">
                                            <i class="bi bi-send-fill fs-3 text-success mb-2"></i>
                                            <h3 id="emailsSent" class="mb-0">0</h3>
                                            <div class="text-muted">Emails Sent</div>
                                          </div>
                                        </div>
                                      </div>
                                      <div class="col-md-4">
                                        <div class="card bg-warning bg-opacity-10 border-0">
                                          <div class="card-body text-center">
                                            <i class="bi bi-exclamation-triangle-fill fs-3 text-warning mb-2"></i>
                                            <h3 id="emailsFailed" class="mb-0">0</h3>
                                            <div class="text-muted">Failed Sends</div>
                                          </div>
                                        </div>
                                      </div>
                                    </div>

                                    <!-- 🔵 Progress Bar -->
                                    <div class="progress-container mt-4">
                                      <div id="progressBar" class="progress-bar"></div>
                                    </div>

                                    <div class="mt-3">
                                      <h6 class="text-info"><i class="bi bi-terminal me-2"></i>Live Progress</h6>
                                      <div id="progressBox" class="progress-box"></div>
                                    </div>

                                    <!-- Add email list collapse -->
                                    <div class="mt-3">
                                      <button class="btn btn-link p-0 text-decoration-none text-info" type="button" data-bs-toggle="collapse" data-bs-target="#emailList">
                                        <i class="bi bi-list-ul me-2"></i>View Email List
                                      </button>
                                      <div class="collapse mt-2" id="emailList">
                                        <div class="card bg-dark">
                                          <div class="card-body">
                                            <div id="emailListContent" class="small" style="font-family: monospace;"></div>
                                          </div>
                                        </div>
                                      </div>
                                    </div>
                                  </div>

                                  <footer>Developed by <b>Manu Chaturvedi</b> • Flask + Selenium LinkedIn Bot</footer>
                                </div>
                              </div>
                            {% endblock %}

                            {% block scripts %}
                              <script>
                                const form = document.getElementById("automationForm");
                                const progressBox = document.getElementById("progressBox");
                                const runBtn = document.getElementById("runBtn");
                                const progressBar = document.getElementById("progressBar");

                                form.addEventListener("submit", async (e) => {
                                  e.preventDefault();
                                  progressBox.innerHTML = "🚀 Starting automation...\n";
                                  progressBar.style.width = "0%";
                                  runBtn.disabled = true;
                                  runBtn.innerHTML = '<i class="bi bi-hourglass-split me-2"></i>Running...';

                                  const formData = new FormData(form);
                                  const res = await fetch("/run", { method: "POST", body: formData });
                                  if (res.ok) listenProgress();
                                });

                                const stats = {
                                  emailsFound: 0,
                                  emailsSent: 0,
                                  emailsFailed: 0,
                                  emailList: new Set()
                                };

                                function updateStats() {
                                  document.getElementById('emailsFound').textContent = stats.emailsFound;
                                  document.getElementById('emailsSent').textContent = stats.emailsSent;
                                  document.getElementById('emailsFailed').textContent = stats.emailsFailed;
      
                                  // Update email list
                                  const emailListContent = document.getElementById('emailListContent');
                                  emailListContent.innerHTML = Array.from(stats.emailList)
                                    .map(email => `<div class="mb-1">📧 ${email}</div>`)
                                    .join('');
      
                                  // Update progress bar
                                  if (stats.emailsFound > 0) {
                                    const progress = ((stats.emailsSent + stats.emailsFailed) / stats.emailsFound) * 100;
                                    progressBar.style.width = `${progress}%`;
                                    if (stats.emailsFailed > 0) {
                                      progressBar.style.backgroundColor = '#ffc107';
                                    }
                                  }
                                }

                                function addLogLine(msg) {
                                  const time = new Date().toLocaleTimeString();
                                  progressBox.innerHTML += `[${time}] ${msg}\n`;
                                  progressBox.scrollTop = progressBox.scrollHeight;

                                  // Parse message for stats
                                  if (msg.includes('📧 Found')) {
                                    const match = msg.match(/Found (\d+) email/);
                                    if (match) {
                                      stats.emailsFound = parseInt(match[1]);
                                    }
                                  }
                                  else if (msg.includes('✅ Sent to')) {
                                    stats.emailsSent++;
                                    const email = msg.split('✅ Sent to ')[1];
                                    if (email) stats.emailList.add(email);
                                  }
                                  else if (msg.includes('❌ Failed to send email to')) {
                                    stats.emailsFailed++;
                                    const email = msg.split('❌ Failed to send email to ')[1].split(':')[0];
                                    if (email) stats.emailList.add(email);
                                  }

                                  updateStats();

                                  // Check for completion message
                                  if (msg.includes("✅ Automation completed successfully")) {
                                    // Re-enable the run button
                                    runBtn.disabled = false;
                                    runBtn.innerHTML = '<i class="bi bi-play-circle me-2"></i>Run Automation';
        
                                    // Show completion status
                                    progressBar.style.width = "100%";
                                    if (stats.emailsFailed === 0) {
                                      progressBar.style.backgroundColor = "#28a745";
                                    }
        
                                    // Show completion toast
                                    const toast = new bootstrap.Toast(document.createElement('div'));
                                    toast.innerHTML = `
                                      <div class="toast-header ${stats.emailsFailed === 0 ? 'bg-success' : 'bg-warning'} text-white">
                                        <i class="bi bi-check-circle me-2"></i>
                                        <strong class="me-auto">Automation Complete</strong>
                                        <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
                                      </div>
                                      <div class="toast-body">
                                        ✅ Found: ${stats.emailsFound} emails<br>
                                        📨 Sent: ${stats.emailsSent} emails<br>
                                        ${stats.emailsFailed > 0 ? `❌ Failed: ${stats.emailsFailed} emails` : ''}
                                      </div>
                                    `;
                                    document.body.appendChild(toast._element);
                                    toast.show();
        
                                    // Clean up toast after it's hidden
                                    toast._element.addEventListener('hidden.bs.toast', () => {
                                      toast._element.remove();
                                    });
                                  }
                                }

                                function listenProgress() {
                                  const evtSource = new EventSource("/progress");
                                  evtSource.onmessage = function (event) {
                                    const data = event.data;

                                      // If a new job was saved, show a quick link to the Job Posts page
                                      if (data.startsWith("NEW_JOB:")) {
                                        addLogLine(data);
                                        if (!document.getElementById('viewJobsBtn')) {
                                          const container = document.createElement('div');
                                          container.id = 'viewJobsBtn';
                                          container.className = 'mt-3';
                                          container.innerHTML = `<a href="/jobs" target="_blank" class="btn btn-sm btn-outline-info">View Job Posts</a>`;
                                          // Append to card footer area
                                          const card = document.querySelector('.card');
                                          if (card) card.appendChild(container);
                                        }
                                        return;
                                      }

                                    // 🔹 Handle progress bar updates
                                    if (data.startsWith("PROGRESS:")) {
                                      const percent = data.replace("PROGRESS:", "");
                                      progressBar.style.width = percent + "%";
                                      return;
                                    }

                                    addLogLine(data);

                                    if (data.includes("🏁")) {
                                      evtSource.close();
                                      runBtn.disabled = false;
                                      runBtn.innerHTML = '<i class="bi bi-play-circle me-2"></i>Run Again';
                                    }
                                  };
                                }
                              </script>
{% endblock %}

{% block content %}
  <div class="container py-5">
    <div class="col-lg-6 col-md-8 col-sm-10 mx-auto">
      <div class="card p-4 p-md-5">
        <div class="d-flex align-items-center mb-3">
          <i class="bi bi-rocket-takeoff-fill fs-2 text-info me-2"></i>
          <h4 class="mb-0">LinkedIn Email Automation</h4>
        </div>
        <p class="text-light-50 mb-4">
          Run LinkedIn job automation using Chrome profile <b>D:\Profile</b>.  
          Operates in headless mode — no Chrome window opens.
        </p>

        <form id="automationForm">
          <div class="mb-3">
            <div class="alert alert-info">
              <i class="bi bi-info-circle me-2"></i>
              Emails will be sent from manudrive06@gmail.com with your email in CC
            </div>
          </div>

          <div class="mb-3">
            <label>Email Subject</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-card-text"></i></span>
              <input type="text" name="subject" class="form-control" placeholder="Application for DevOps Engineer..." required />
            </div>
          </div>

          <div class="mb-3">
            <label>Email Body</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-chat-dots"></i></span>
              <textarea name="content" class="form-control" rows="5" placeholder="Write your message here..." required></textarea>
            </div>
          </div>

          <div class="mb-3">
            <label>Attach Resume</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-paperclip"></i></span>
              <input type="file" name="resume" class="form-control" required />
            </div>
          </div>

          <div class="d-grid mt-4">
            <button type="submit" id="runBtn" class="btn btn-primary">
              <i class="bi bi-play-circle me-2"></i>Run Automation
            </button>
          </div>
        </form>

        <!-- Stats Cards -->
        <div class="row mt-4">
          <div class="col-md-4">
            <div class="card bg-info bg-opacity-10 border-0">
              <div class="card-body text-center">
                <i class="bi bi-envelope-fill fs-3 text-info mb-2"></i>
                <h3 id="emailsFound" class="mb-0">0</h3>
                <div class="text-muted">Emails Found</div>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card bg-success bg-opacity-10 border-0">
              <div class="card-body text-center">
                <i class="bi bi-send-fill fs-3 text-success mb-2"></i>
                <h3 id="emailsSent" class="mb-0">0</h3>
                <div class="text-muted">Emails Sent</div>
              </div>
            </div>
          </div>
          <div class="col-md-4">
            <div class="card bg-warning bg-opacity-10 border-0">
              <div class="card-body text-center">
                <i class="bi bi-exclamation-triangle-fill fs-3 text-warning mb-2"></i>
                <h3 id="emailsFailed" class="mb-0">0</h3>
                <div class="text-muted">Failed Sends</div>
              </div>
            </div>
          </div>
        </div>

        <!-- Progress Bar -->
        <div class="progress-container mt-4">
          <div id="progressBar" class="progress-bar"></div>
        </div>

        <div class="mt-3">
          <h6 class="text-info"><i class="bi bi-terminal me-2"></i>Live Progress</h6>
          <div id="progressBox" class="progress-box"></div>
        </div>

        <!-- Add email list collapse -->
        <div class="mt-3">
          <button class="btn btn-link p-0 text-decoration-none text-info" type="button" data-bs-toggle="collapse" data-bs-target="#emailList">
            <i class="bi bi-list-ul me-2"></i>View Email List
          </button>
          <div class="collapse mt-2" id="emailList">
            <div class="card bg-dark">
              <div class="card-body">
                <div id="emailListContent"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
{% endblock %}

{% block scripts %}
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Initialize DOM elements and stats object on load
    document.addEventListener('DOMContentLoaded', () => {
      const automationForm = document.getElementById('automationForm');
      const runBtn = document.getElementById('runBtn');
      const progressBox = document.getElementById('progressBox');
      const progressBar = document.getElementById('progressBar');
      const emailListContent = document.getElementById('emailListContent');
      
      // Global stats object
      window.stats = {
        emailsFound: 0,
        emailsSent: 0,
        emailsFailed: 0,
        emailList: new Set()
      };
      
      // Initialize event handlers
      automationForm.addEventListener('submit', handleSubmit);
    });

    function updateStats() {
      document.getElementById('emailsFound').textContent = window.stats.emailsFound;
      document.getElementById('emailsSent').textContent = window.stats.emailsSent;
      document.getElementById('emailsFailed').textContent = window.stats.emailsFailed;
      
      // Update email list
      document.getElementById('emailListContent').innerHTML = Array.from(window.stats.emailList)
        .map(email => `<div class="text-light">${email}</div>`)
        .join('');
    }

    async function handleSubmit(e) {
      e.preventDefault();
      const runBtn = document.getElementById('runBtn');
      const progressBox = document.getElementById('progressBox');
      const progressBar = document.getElementById('progressBar');
      
      // Reset stats
      window.stats.emailsFound = 0;
      window.stats.emailsSent = 0;
      window.stats.emailsFailed = 0;
      window.stats.emailList.clear();
      updateStats();

      // Reset progress display
      progressBox.innerHTML = '';
      progressBar.style.width = '0%';
      progressBar.style.backgroundColor = '#0072ff';

      // Show loading state
      runBtn.disabled = true;
      runBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Running...';

      // Get form data
      const formData = new FormData(automationForm);

      try {
        const response = await fetch('/run_automation', {
          method: 'POST',
          body: formData
        });

        if (!response.ok) {
          throw new Error('Network response was not ok');
        }

        // Start listening for progress updates
        listenProgress();

      } catch (error) {
        console.error('Error:', error);
        progressBox.innerHTML += `\n❌ Error: ${error.message}`;
        runBtn.disabled = false;
        runBtn.innerHTML = '<i class="bi bi-play-circle me-2"></i>Run Automation';
      }
    };

    function addLogLine(msg) {
      progressBox.innerHTML += msg + "\n";
      progressBox.scrollTop = progressBox.scrollHeight;

      // Parse message for stats
      if (msg.includes('📧 Found')) {
        const match = msg.match(/Found (\d+) email/);
        if (match) {
          window.stats.emailsFound = parseInt(match[1]);
        }
      }
      else if (msg.includes('✅ Sent to')) {
        window.stats.emailsSent++;
        const email = msg.split('✅ Sent to ')[1];
        if (email) window.stats.emailList.add(email);
      }
      else if (msg.includes('❌ Failed to send email to')) {
        window.stats.emailsFailed++;
        const email = msg.split('❌ Failed to send email to ')[1].split(':')[0];
        if (email) window.stats.emailList.add(email);
      }

      updateStats();

      // Check for completion message
      if (msg.includes("✅ Automation completed successfully")) {
        // Re-enable the run button
        runBtn.disabled = false;
        runBtn.innerHTML = '<i class="bi bi-play-circle me-2"></i>Run Automation';

        // Show completion status
        progressBar.style.width = "100%";
        if (window.stats.emailsFailed === 0) {
          progressBar.style.backgroundColor = "#28a745";
        }

        // Show completion toast
        const toast = new bootstrap.Toast(document.createElement('div'));
        toast.innerHTML = `
          <div class="toast-header ${window.stats.emailsFailed === 0 ? 'bg-success' : 'bg-warning'} text-white">
            <i class="bi bi-check-circle me-2"></i>
            <strong class="me-auto">Automation Complete</strong>
            <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
          </div>
          <div class="toast-body">
            ✅ Found: ${window.stats.emailsFound} emails<br>
            📨 Sent: ${window.stats.emailsSent} emails<br>
            ${window.stats.emailsFailed > 0 ? `❌ Failed: ${window.stats.emailsFailed} emails` : ''}
          </div>
        `;
        document.body.appendChild(toast._element);
        toast.show();

        // Clean up toast after it's hidden
        toast._element.addEventListener('hidden.bs.toast', () => {
          toast._element.remove();
        });
      }
    }

    function listenProgress() {
      const evtSource = new EventSource("/progress");
      evtSource.onmessage = function (event) {
        const data = event.data;

          // If a new job was saved, show a quick link to the Job Posts page
          if (data.startsWith("NEW_JOB:")) {
            addLogLine(data);
            if (!document.getElementById('viewJobsBtn')) {
              const container = document.createElement('div');
              container.id = 'viewJobsBtn';
              container.className = 'mt-3';
              container.innerHTML = `<a href="/jobs" target="_blank" class="btn btn-sm btn-outline-info">View Job Posts</a>`;
              // Append to card footer area
              const card = document.querySelector('.card');
              if (card) card.appendChild(container);
            }
            return;
          }

        // Handle progress bar updates
        if (data.startsWith("PROGRESS:")) {
          const percent = data.replace("PROGRESS:", "");
          progressBar.style.width = percent + "%";
          return;
        }

        addLogLine(data);

        if (data.includes("🏁")) {
          evtSource.close();
          runBtn.disabled = false;
          runBtn.innerHTML = '<i class="bi bi-play-circle me-2"></i>Run Again';
        }
      };
    }
  </script>
{% endblock %}